# GitHub Copilot + Claude Sonnet 4 Visual Testing Configuration

# Enable Copilot-optimized visual testing
COPILOT_VISUAL_TESTS=true
COPILOT_AI_MODEL=claude-sonnet-4

# Test mode optimized for Copilot workflow
TEST_MODE=copilot-assisted

# Screenshot settings optimized for Claude vision
SCREENSHOT_FORMAT=png
SCREENSHOT_DPI=96
SCREENSHOT_MAX_WIDTH=1920
SCREENSHOT_QUALITY=95

# Copilot integration settings
COPILOT_ANALYSIS_DEPTH=detailed
COPILOT_FOCUS_AREAS=ui-bugs,accessibility,responsive-design,3d-rendering
COPILOT_GENERATE_FIXES=true
COPILOT_WORKSPACE_INTEGRATION=true

# AI Analysis prompts for Claude Sonnet 4
AI_ANALYSIS_STYLE=technical-detailed
AI_RESPONSE_FORMAT=vscode-integrated

# Timeout settings optimized for VS Code workflow
PAGE_LOAD_TIMEOUT=20000
ELEMENT_WAIT_TIMEOUT=8000
COPILOT_ANALYSIS_TIMEOUT=30000

# Performance thresholds for development workflow
COMPONENT_LOAD_THRESHOLD=12000
3D_LOAD_THRESHOLD=18000
NAVIGATION_THRESHOLD=2000

# VS Code integration
VSCODE_PROBLEM_MARKERS=true
VSCODE_TASK_INTEGRATION=true
VSCODE_TERMINAL_OUTPUT=enhanced

# Development-focused resolution testing
TEST_RESOLUTIONS=vscode-preview,desktop-dev,mobile-debug
# vscode-preview: 1200x800, desktop-dev: 1920x1080, mobile-debug: 375x667

# Report generation for VS Code
GENERATE_COPILOT_REPORTS=true
REPORT_FORMAT=markdown-vscode
COPILOT_SUGGESTIONS_FILE=release-workflow/.copilot-visual-suggestions.md

# Integration with VS Code tasks and terminal
TERMINAL_INTEGRATION=true
TASK_RUNNER_INTEGRATION=true
